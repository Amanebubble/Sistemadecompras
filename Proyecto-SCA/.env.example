# Archivo de Ejemplo de Variables de Entorno (.env)
# Renombra este archivo a ".env" y reemplaza los valores con las claves reales.

# Clave de la API de Groq para la Inteligencia Artificial (Llama-3.3-70b)
GROQ_API_KEY=gsk_tusuperclave_aqui_generada

# Las contraseñas de correos se inyectan en tiempo de ejecución (desde el panel web)
# No necesitas agregarlas manualmente aquí si usas la interfaz web.
# PASS_FOODSERVICES=TuContraseñaFuerteAqui123!
